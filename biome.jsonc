// Biome lints and formats the JS and CSS; run by the pre-commit hook (`mise run lint`).
{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**/*.js",
      "**/*.mjs",
      "**/*.css",
      // Vendored files stay as upstream ships them.
      "!games/static/games/vendor",
      "!**/*.min.js",
      "!**/*.min.css",
      "!vm/out",
      "!vm/node_modules",
      "!site/node_modules",
      "!site/dist",
      "!site/.astro"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "linter": { "rules": { "preset": "recommended" } },
  "javascript": {
    "formatter": { "quoteStyle": "single" },
    // Page globals: xterm.js, our TerminalWindow, the game_detail.html config and v86.
    "globals": ["Terminal", "TerminalWindow", "gameConfig", "V86"]
  },
  "overrides": [
    {
      // The page scripts are plain scripts: function expressions (the bar's click handlers
      // rely on `this`) and string concatenation.
      "includes": ["games/static/**", "site/src/scripts/**"],
      "linter": {
        "rules": {
          "complexity": { "useArrowFunction": "off" },
          "style": { "useTemplate": "off" }
        }
      }
    },
    {
      // The VM Image scripts are ES modules run by node, written with double quotes.
      "includes": ["vm/**"],
      "javascript": { "formatter": { "quoteStyle": "double" } }
    }
  ]
}
