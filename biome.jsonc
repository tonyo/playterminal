// Biome lints and formats the JS and CSS; run by the pre-commit hook (`mise run lint`).
{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**/*.js",
      "**/*.mjs",
      "**/*.css",
      "!**/*.min.js",
      "!**/*.min.css",
      "!vm/out",
      "!vm/node_modules",
      "!site/node_modules",
      "!site/dist",
      "!site/.astro"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "linter": { "rules": { "preset": "recommended" } },
  "javascript": { "formatter": { "quoteStyle": "single" } },
  "overrides": [
    {
      // The VM Image scripts are ES modules run by node, written with double quotes.
      "includes": ["vm/**"],
      "javascript": { "formatter": { "quoteStyle": "double" } }
    }
  ]
}
