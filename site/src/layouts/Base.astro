---
import '../styles/base-styles.css';
import logo from '../assets/play_logo.png';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="PlayTerminal: play terminal-based games right in your browser."
    />
    <meta name="keywords" content="PlayTerminal,Games,Terminal,ASCII,v86" />
    <meta name="author" content="Anton Ovchinnikov" />
    <slot name="head" />
    <title>PlayTerminal</title>
  </head>
  <body>
    <div id="page-content">
      <div class="column-side">
        <a href="/games/">
          <img src={logo.src} width="250" alt="PlayTerminal logo" />
        </a>
        <br />
        <br />
        <div id="sidebar">
          <div><a href="/">Page zero</a></div>
          <div><a href="/games/">Games</a></div>
          <div><a href="/about/">About</a></div>
          <div><a href="/licenses/">Licenses</a></div>
        </div>
      </div>
      <div class="column-main">
        <slot />
      </div>
    </div>
  </body>
</html>
